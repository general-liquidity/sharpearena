  "real_controls": {
    "stride_returns": 120,
    "symbols_rule": "first four symbols in sorted order",
    "datasets": {
      "crypto-majors-1d.csv": {
        "sha256": "1854e76e9811387dd1ff3db64308eceb613ad05c9eee0011762eddc48f538a26",
        "expected_windows": 8
      },
      "fx-majors-1d.csv": {
